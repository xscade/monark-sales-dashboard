# TEMPLATE ONLY — this file is committed to git.
# Never put real values here. Copy to .env (gitignored) and fill that in.

# ===========================================================================
# Supabase
# ===========================================================================
# Two connection strings, and they are NOT interchangeable.
# Supabase dashboard → Project Settings → Database → Connection string.
#
# COPY THESE VERBATIM from the Supabase dashboard — do not hand-edit the host.
# The pooler hostname encodes your project's REGION, and getting it wrong fails
# with 'FATAL: tenant/user postgres.<ref> not found', which reads like a
# credentials problem and is not one.
#
# DATABASE_URL — TRANSACTION pooler, port 6543.
#   Used by the API and cron at runtime. Every serverless invocation is a fresh
#   client; without pooling, Postgres runs out of backends long before you run
#   out of traffic.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# DIRECT_URL — SESSION pooler, port 5432, on the POOLER host.
#   Used only by migrations and seeds. DDL needs a stable session.
#   Do NOT use db.PROJECT_REF.supabase.co here: direct connections are
#   IPv6-only on newer projects, which silently breaks CI runners.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase project details. Needed once the dashboard uses Supabase Auth.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=

# Bypasses RLS completely — server-side only, never in a browser bundle and
# never in this file.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ===========================================================================
# App
# ===========================================================================
APP_URL=http://localhost:3000
NODE_ENV=development

# openssl rand -base64 48
SESSION_SECRET=

# openssl rand -base64 32  (must decode to exactly 32 bytes)
#
# Must be IDENTICAL in local .env and in Vercel. Seeding writes encrypted Meta
# and Google credentials into the shared Supabase database; a mismatch means
# production cannot decrypt them and every delivery fails looking like a bad
# access token.
#
# Not rotatable in place — rotating orphans every stored credential.
CREDENTIALS_ENCRYPTION_KEY=

# openssl rand -hex 32
# Bearer token the scheduler sends to /api/cron/outbox. The handler fails closed
# when this is unset.
CRON_SECRET=

# ===========================================================================
# Conversion engine
# ===========================================================================
# Global kill switch, on top of each destination's own dry_run flag.
CONVERSIONS_DRY_RUN=true

# Alert when the oldest undelivered conversion exceeds this age (minutes).
# Meta rejects events whose event_time is >7 days old, so a stuck queue is
# permanent data loss rather than mere latency.
OUTBOX_LAG_ALERT_MINUTES=180

# Wall-clock budget for one drain. Must fit inside the SCHEDULER's timeout, not
# just the platform's: cron-job.org aborts at 30s. 20000 leaves headroom for the
# lag query and the response.
OUTBOX_TIME_BUDGET_MS=20000
WORKER_BATCH_SIZE=200

# ===========================================================================
# Meta Conversions API
# ===========================================================================
META_DATASET_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
# Routes events to the Events Manager test console — visible for debugging but
# NOT used for optimisation. Blank in production.
META_TEST_EVENT_CODE=

# ===========================================================================
# Google Data Manager API
# ===========================================================================
# As of 2026-06-15 offline conversion uploads moved OUT of the Google Ads API
# into the Data Manager API. Do not build against UploadClickConversions.
GOOGLE_DM_OPERATING_ACCOUNT_ID=
GOOGLE_DM_LOGIN_ACCOUNT_ID=
GOOGLE_DM_PRODUCT_DESTINATION_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATED_USER=
