{
  "name": "@monark/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "once": "tsx --env-file-if-exists=../../.env src/run-once.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monark/db": "workspace:*",
    "@monark/services": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
